# --- Database (Docker Compose also reads these) ---
POSTGRES_USER=pdf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pdf_assistant
DATABASE_URL=postgres://pdf:change-me@localhost:5433/pdf_assistant

# --- Redis (BullMQ queue) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# --- API ---
PORT=3001
# Origin of the web app (CORS, cookies and which site may embed PDFs)
WEB_ORIGIN=http://localhost:3000
# Secret used to sign session cookies — at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Set to "production" when deploying: secure cookies, no automatic schema sync
NODE_ENV=development

# --- Storage & processing ---
STORAGE_PATH=
MAX_PDF_PAGES=500

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
